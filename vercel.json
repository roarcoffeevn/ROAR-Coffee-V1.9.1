{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/|assets/|roar-snapshot\\.json|og-thumbnail\\.svg|robots\\.txt|sitemap\\.xml|pwa-.*\\.png|apple-touch-icon\\.png|sw\\.js|workbox-.*\\.js|registerSW\\.js|favicon|manifest).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/roar-snapshot.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
